# Compose overrides this to production and fixes the database at /data.
TUTORING_ENVIRONMENT=development
# Development may use the ignored default under backend/var.
# TUTORING_DATABASE_URL=sqlite:////absolute/path/to/tutoring.sqlite3
TUTORING_APPLICATION_ORIGIN=http://127.0.0.1:7310
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
TUTORING_INVITATION_ENCRYPTION_KEY=
